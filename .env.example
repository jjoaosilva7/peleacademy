# Copie para .env e preencha. Sem estas chaves, os botões Google e Apple abrem o modo de demonstração.

# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo da Web).
# Em "Origens JavaScript autorizadas" cadastre http://localhost:5173 e o endereço do site na Vercel.
VITE_GOOGLE_CLIENT_ID=

# Apple Developer > Certificates, Identifiers & Profiles > Services IDs (exige conta paga).
# Cadastre o domínio do site e a URL de retorno. O clientId é o identificador do Services ID.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://SEU-SITE.vercel.app/
